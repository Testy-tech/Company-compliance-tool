# Copy to .env.local and fill in. Never commit .env.local.
# SERVER-ONLY secrets: never prefix these with NEXT_PUBLIC_, which would
# expose them to the browser bundle.

# Anthropic API key, used only by server route handlers (Phase 6+).
ANTHROPIC_API_KEY=

# Optional: Claude model per feature (defaults: tailoring claude-sonnet-5, developments claude-opus-5).
TAILOR_MODEL=
DEVELOPMENTS_MODEL=

# Secret for the scheduled developments check (/api/cron/developments/[jurisdiction]).
# At least 16 characters. Vercel Cron sends it as "Authorization: Bearer <value>".
# The schedule is in vercel.json (weekly, Mondays from 05:00 UTC).
CRON_SECRET=

# Shared store for developments results and rate limits: Upstash Redis or Vercel KV
# (either pair). Without them an in-memory store is used: fine locally, not in production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Password protecting /admin/research (Phase 9).
ADMIN_PASSWORD=
